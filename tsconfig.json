{
    "compilerOptions": {
        "module": "CommonJS",
		"moduleResolution": "Node",
		"ignoreDeprecations": "6.0",
       	"target": "ES2023",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "out",
		"declaration": false,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitThis": true
    },
    "exclude": [
		"node_modules",
		"out"
	]
}
